{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": {"format": "%(asctime)s %(levelname)s %(name)s: %(message)s"}
  },
  "handlers": {
    "stderr": {"class": "logging.StreamHandler", "stream": "ext://sys.stderr", "formatter": "plain"}
  },
  "root": {"handlers": ["stderr"], "level": "INFO"},
  "loggers": {
    "uvicorn": {"handlers": ["stderr"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stderr"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false},
    "httpx": {"level": "WARNING"},
    "httpcore": {"level": "WARNING"},
    "multipart": {"level": "WARNING"}
  }
}
