# Starling configuration template. Copy to `.env` and fill in values.
# Never commit a real `.env`. Every setting is described in docs/CONFIGURATION.md.
# Values in [[DOUBLE_BRACKETS]] are business details only the owner can provide.

# --------------------------------------------------------------------------- core
# production | development | e2e
STARLING_ENV=development
# The public origin customers visit (https in production), no trailing slash.
STARLING_PUBLIC_URL=http://127.0.0.1:8765
# Persistent data (control database, customer data, backups). Must be an encrypted volume in production.
STARLING_DATA_DIR=/data
# Session and signing secret: 32+ random bytes, base64url. Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
STARLING_SECRET_KEY=
# During a secret rotation only: the old value, so existing sessions, CSRF tokens and encrypted
# two-factor secrets keep working until they are re-issued. Remove it after the rotation window.
STARLING_SECRET_KEY_PREVIOUS=
# Key shared by the gateway and the services process (32+ random bytes, base64url). Required in production.
STARLING_SERVICES_TOKEN_KEY=
# os (production: one OS user per customer engine) | none (development and e2e only)
STARLING_ISOLATION=none
# Comma-separated reverse-proxy addresses allowed to set X-Forwarded-For.
STARLING_TRUSTED_PROXIES=
# Chrome Web Store extension id(s) allowed to sign in (comma-separated).
STARLING_EXTENSION_IDS=
# Owner accounts that may be granted admin with the CLI (comma-separated emails).
STARLING_OWNER_EMAILS=
STARLING_SUPPORT_EMAIL=[[OPERATOR_CONTACT_EMAIL]]
STARLING_EXTENSION_MIN_VERSION=1.0.0
# Link to the published Chrome Web Store listing (leave empty until the listing is live).
STARLING_EXTENSION_INSTALL_URL=
STARLING_CONSENT_VERSION=2026-09-22.1

# --------------------------------------------------------------------------- business and legal
OPERATOR_COMPANY_NAME=[[OPERATOR_COMPANY_NAME]]
OPERATOR_REGISTERED_ADDRESS=[[OPERATOR_REGISTERED_ADDRESS]]
OPERATOR_CONTACT_EMAIL=[[OPERATOR_CONTACT_EMAIL]]
OPERATOR_PRIVACY_CONTACT=[[OPERATOR_PRIVACY_CONTACT]]
OPERATOR_JURISDICTION=[[OPERATOR_JURISDICTION]]
OPERATOR_GOVERNING_LAW_VENUE=[[OPERATOR_GOVERNING_LAW_VENUE]]
OPERATOR_EFFECTIVE_DATE=[[OPERATOR_EFFECTIVE_DATE]]
HOSTING_PROVIDER=[[HOSTING_PROVIDER]]
EMAIL_PROVIDER=[[EMAIL_PROVIDER]]
AI_SUBPROCESSORS=OpenAI
# Plain-language retention schedule and refund policy shown on the privacy and refunds pages.
RETENTION_PERIODS=[[RETENTION_PERIODS]]
REFUND_POLICY=[[REFUND_POLICY]]

# --------------------------------------------------------------------------- email
# smtp (production) | outbox (development and e2e: emails are stored, not sent)
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=

# --------------------------------------------------------------------------- AI (owner's key; never shared with customers)
# openai, or anthropic (Claude Haiku 5.5; docs/AI-PROVIDER.md). For anthropic, delete AI_BASE_URL,
# the three AI_MODEL_* lines and WEB_SEARCH below (their defaults then follow the provider), and set
# AI_SUBPROCESSORS=Anthropic above.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Optional second key for zero-downtime rotation.
AI_API_KEY_SECONDARY=
AI_MODEL_QUALITY=gpt-5.6-luna
AI_MODEL_FAST=gpt-5.6-luna
AI_MODEL_VISION=gpt-5.6-luna
AI_REASONING_EFFORT=none
AI_CREDIT_MULTIPLIER=1
AI_MAX_CALLS_PER_REQUEST=12
AI_MAX_INPUT_TOKENS_PER_CALL=8000
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_S=25
# Service-wide spending safeguards (USD). Also set a hard spend limit in the provider dashboard.
# The defaults stay below OpenAI usage tier 1's $100 monthly limit; raise both as the account tier rises.
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=90
AI_FREE_TRIP_PCT=80
# Real web search with the same key: about a cent a search, at most one a press, and only for a
# post with a checkable, time-sensitive claim. WEB_SEARCH_MODEL defaults to AI_MODEL_FAST.
WEB_SEARCH=true
# WEB_SEARCH_MODEL=gpt-5.6-luna
WEB_SEARCH_CONTEXT_SIZE=low
WEB_SEARCH_PER_ACCOUNT_DAY=20
# Background topic research for an account's beat (paid plans only, never Free), paced so the
# background share of the plan lasts the period; this is the most a UTC day may take.
WEB_SEARCH_BACKGROUND_PER_ACCOUNT_DAY=8
WEB_SEARCH_TIMEOUT_S=8

# --------------------------------------------------------------------------- plans
# PLANS_FILE=backend/server/config/plans.toml
PAST_DUE_GRACE_DAYS=7

# --------------------------------------------------------------------------- ceilings
# Sign-ups accepted per hour for the whole site (on top of 10 an hour per network). 0 = no ceiling.
SIGNUP_GLOBAL_PER_HOUR=500
# Connected browsers one account may hold at once. 0 = no limit.
MAX_DEVICES_PER_ACCOUNT=20
DISPOSABLE_DOMAINS_FILE=

# --------------------------------------------------------------------------- Stripe (owner's account)
# test (development) | live (production)
STRIPE_MODE=test
# Only for a pre-launch rehearsal on the deployed host: lets production run on Stripe's sandbox. Every page
# then says payments are in test mode. Remove it when you switch to live keys.
STRIPE_ALLOW_TEST_MODE=false
# A restricted key (rk_...) with the permissions listed in docs/PAYMENTS.md is recommended.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Set during a webhook secret rotation, then remove.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_API_VERSION=2026-08-26.dahlia
STRIPE_PORTAL_CONFIGURATION_ID=
# Second portal configuration used only for confirmed upgrades (created by `stripe-setup`).
STRIPE_PORTAL_UPGRADE_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_CODE=
STRIPE_BLOCK_PREPAID=true
STRIPE_ALLOW_PROMO_CODES=false

# --------------------------------------------------------------------------- engines
ENGINE_MAX_LIVE=6
ENGINE_IDLE_SECONDS=1800
ENGINE_MEMORY_SOFT_MB=512
ENGINE_MEMORY_HARD_MB=768
ENGINE_UID_BASE=200000

# --------------------------------------------------------------------------- security and operations
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_MAX_CONCURRENT=4
LOG_LEVEL=INFO
BACKUP_DIR=/data/backups
# Long random passphrase for encrypted backups. Store it outside the server (password manager).
BACKUP_PASSPHRASE=
ALERT_EMAIL=
